# Exact attendance API used by the Android app.
ATTENDANCE_API_URL=https://mlsaegypt.org/api/attendance/mark

# Server-side staff access configuration. Never expose these as NEXT_PUBLIC_*.
APP_ACCESS_KEY=replace-with-master-staff-key
REMOTE_CONFIG_URL=https://example.com/event-access-key.txt
SESSION_SECRET=replace-with-a-long-random-server-secret

# Public support links shown in the error dialog (optional).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
